{
  "installCommand": "npm install --registry https://registry.npmjs.org/ && npm install --prefix client --registry https://registry.npmjs.org/",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[...path]" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/[...path].js": {
      "includeFiles": "server/src/**",
      "maxDuration": 30
    }
  }
}
