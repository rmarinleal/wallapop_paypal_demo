# PayPal merchant (commerce) credentials
# Dashboard: https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# sandbox | live
PAYPAL_ENV=sandbox
PAYPAL_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=EUR
PAYPAL_BRAND_NAME=Wallapop

PORT=8012
CLIENT_ORIGIN=http://localhost:8011

# En Vercel no hace falta CLIENT_ORIGIN: return_url usa el host del request.
# Copia estas vars en Project Settings → Environment Variables (sin el .env).
